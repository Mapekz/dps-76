{
  "name": "dps-76",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:design": "bun scripts/lint-design.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test --parallel --path-ignore-patterns='**/.claude/**'",
    "test:watch": "bun test --watch --isolate --path-ignore-patterns='**/.claude/**'",
    "bench": "bun scripts/bench-engine.ts",
    "extract": "bun scripts/extract/run-all.ts",
    "extract:diff": "bun scripts/extract/diff-report.ts",
    "vet:weapons": "bun scripts/vet-weapons.ts",
    "audit:inert": "bun scripts/audit-inert.ts",
    "audit:records": "bun scripts/audit-records.ts",
    "wire-dict:build": "bun scripts/build-wire-dictionary.ts",
    "esm:walk": "esm walk",
    "preview": "vite preview",
    "build:gh-pages": "NODE_ENV=production bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/spline-sans-mono": "^5.2.8",
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "oxc-transform-react": "^0.147.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.4"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild"
  ]
