{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.scripts.json"
    }
  ],
  "compilerOptions": {
    // Inert for tsc itself (solution-style configs with `files: []` don't apply
    // their own compilerOptions to the build), but load-bearing for Bun: it
    // resolves `@/*` at runtime by reading the nearest tsconfig.json's `paths`
    // directly, not through tsc's project-reference graph. Removing this breaks
    // `bun run extract`/`extract:diff`/`vet:weapons` the moment any file
    // they transitively import (e.g. src/data/omods.ts) uses a value-level `@/`
    // import — confirmed by running `vet:weapons` after removing it.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
